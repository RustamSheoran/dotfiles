#!/bin/bash
set -euo pipefail

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/cache-clean-next"
mkdir -p "$(dirname "$STATE_FILE")"

now=$(date +%s)
if [[ -f "$STATE_FILE" ]]; then
  next_run=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
  if [[ "$next_run" =~ ^[0-9]+$ ]] && (( now < next_run )); then
    exit 0
  fi
fi

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
TARGETS=(
  "$CACHE_DIR/pip"
  "$CACHE_DIR/zen"
  "$CACHE_DIR/chromium"
  "$CACHE_DIR/yay"
  "$CACHE_DIR/spotify"
  "$CACHE_DIR/tracker3"
  "$CACHE_DIR/mise"
)

for dir in "${TARGETS[@]}"; do
  if [[ -d "$dir" ]]; then
    ionice -c 3 nice -n 19 rm -rf -- "$dir"/*
  fi
done

date -d '+2 days' +%s > "$STATE_FILE"
